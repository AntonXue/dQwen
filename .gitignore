# agent worktrees + local settings. NOTE: git only honours '#' at the START of a
# line, so a trailing comment here made the pattern literal and matched nothing --
# leaving a whole second checkout (and _runs/, GBs of eval dumps) untracked-visible.
.claude/
__pycache__/
# scratch launcher logs from background eval queues
_*.out
*.py[cod]
*.egg-info/
.venv*/
build/
dist/
# large binary fixtures live outside git; see tests/fixtures/README
*.pt
*.safetensors
third_party/
!third_party/*.md
!third_party/*.json
!third_party/*.sh
_runs/*
!_runs/README.md
!_runs/*/
_runs/*/*
!_runs/*/README.md
!_runs/*/lane.sh
third_party/
